    },

    {
      "id": 22,
      "title": "Dataset Sync Summary",
      "description": "Latest state for each replicated dataset. Success=green/OK, failure=red/FAIL. Bytes estimated via 'zfs send -nvP' (0 for bookmark-based sends).",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "syncoid_dataset_sync_success{source_host=~\"$source_host\",destination_host=~\"$destination_host\",source_pool=~\"$source_pool\",destination_pool=~\"$destination_pool\",source_dataset=~\"$source_dataset\",identifier=~\"$identifier\"}",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - syncoid_dataset_sync_timestamp_seconds{source_host=~\"$source_host\",destination_host=~\"$destination_host\",source_pool=~\"$source_pool\",destination_pool=~\"$destination_pool\",source_dataset=~\"$source_dataset\",identifier=~\"$identifier\"}",
          "instant": true,
          "legendFormat": "",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "syncoid_dataset_sync_duration_seconds{source_host=~\"$source_host\",destination_host=~\"$destination_host\",source_pool=~\"$source_pool\",destination_pool=~\"$destination_pool\",source_dataset=~\"$source_dataset\",identifier=~\"$identifier\"}",
          "instant": true,
          "legendFormat": "",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "syncoid_dataset_target_snapshot_count{source_host=~\"$source_host\",destination_host=~\"$destination_host\",source_pool=~\"$source_pool\",destination_pool=~\"$destination_pool\",source_dataset=~\"$source_dataset\",identifier=~\"$identifier\"}",
          "instant": true,
          "legendFormat": "",
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "syncoid_dataset_bytes_sent_estimated_total{source_host=~\"$source_host\",destination_host=~\"$destination_host\",source_pool=~\"$source_pool\",destination_pool=~\"$destination_pool\",source_dataset=~\"$source_dataset\",identifier=~\"$identifier\"}",
          "instant": true,
          "legendFormat": "",
          "refId": "E"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "syncoid_dataset_throughput_bytes_per_second{source_host=~\"$source_host\",destination_host=~\"$destination_host\",source_pool=~\"$source_pool\",destination_pool=~\"$destination_pool\",source_dataset=~\"$source_dataset\",identifier=~\"$identifier\"}",
          "instant": true,
          "legendFormat": "",
          "refId": "F"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "destination_dataset": false
            },
            "renameByName": {
              "Value #A": "Status",
              "Value #B": "Last Sync Ago",
              "Value #C": "Duration",
              "Value #D": "Target Snaps",
              "Value #E": "Bytes Sent",
              "Value #F": "Throughput",
              "source_host": "Source Host",
              "destination_host": "Dest Host",
              "source_pool": "Src Pool",
              "destination_pool": "Dst Pool",
              "source_dataset": "Source Dataset",
              "destination_dataset": "Dest Dataset",
              "identifier": "Identifier"
            },
            "indexByName": {
              "source_host": 0,
              "destination_host": 1,
              "source_pool": 2,
              "destination_pool": 3,
              "source_dataset": 4,
              "destination_dataset": 5,
              "identifier": 6,
              "Value #A": 7,
              "Value #B": 8,
              "Value #C": 9,
              "Value #D": 10,
              "Value #E": 11,
              "Value #F": 12
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Status", "desc": false } ]
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "custom.width", "value": 80 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red",   "value": null },
                    { "color": "green", "value": 1    }
                  ]
                }
              },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "FAIL" },
                      "1": { "text": "OK"   }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Last Sync Ago" },
            "properties": [
              { "id": "unit", "value": "dtdurations" },
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null  },
                    { "color": "yellow", "value": 7200  },
                    { "color": "red",    "value": 86400 }
                  ]
                }
              },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [ { "id": "unit", "value": "s" } ]
          },
          {
            "matcher": { "id": "byName", "options": "Bytes Sent" },
            "properties": [ { "id": "unit", "value": "decbytes" } ]
          },
          {
            "matcher": { "id": "byName", "options": "Throughput" },
            "properties": [ { "id": "unit", "value": "Bps" } ]
          }
        ]
      }
    },

