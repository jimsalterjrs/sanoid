    },

    {
      "id": 19,
      "title": "Run Success History",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "syncoid_run_success{source_host=~\"$source_host\",destination_host=~\"$destination_host\",source_pool=~\"$source_pool\",destination_pool=~\"$destination_pool\",identifier=~\"$identifier\"}",
          "legendFormat": "{{source_host}}→{{destination_host}} ({{source_pool}}→{{destination_pool}})",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
