      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count by (source_host, destination_host) (syncoid_dataset_sync_success{source_host=~\"$source_host\",destination_host=~\"$destination_host\",source_pool=~\"$source_pool\",destination_pool=~\"$destination_pool\",source_dataset=~\"$source_dataset\",identifier=~\"$identifier\"} == 1)",
